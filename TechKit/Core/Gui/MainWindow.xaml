<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tech Kit" Width="1360" Height="860" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="14,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Width="32" Height="32">
                        <TextBlock Text="TK" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tech Kit" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtShellInfo" Text="" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnM365" ToolTip="Connect to Microsoft 365 (Graph, Exchange Online, Compliance)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotM365" Width="9" Height="9" Fill="{DynamicResource VerboseBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtM365" Text="Microsoft 365: not connected" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnConsole" Content="Console &#x25BE;" ToolTip="Open a separate PowerShell window with Tech Kit loaded"/>
                    <Button x:Name="BtnElevate" Content="Restart as admin" ToolTip="Restart Tech Kit with administrator rights so admin scripts run without a UAC prompt each time"/>
                    <Button x:Name="BtnSettings" Content="&#x2699; Settings" Margin="0"/>
                </StackPanel>

                <Grid Margin="30,0" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Stretch">
                    <TextBox x:Name="TxtSearch" Height="32" Padding="30,4,8,4"/>
                    <TextBlock Text="&#x2315;" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="TxtSearchHint" Text="Search scripts by name, description or tag  (Ctrl+F)" Margin="31,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SubTextBrush}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="160"/>
                <ColumnDefinition Width="350" MinWidth="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Style="{StaticResource SectionLabel}" Margin="16,14,0,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10">
                        <Button x:Name="BtnNewScript" Content="+  New script" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
                        <Button x:Name="BtnOpenScripts" Content="Open Scripts folder" Margin="0,0,0,6"/>
                        <Button x:Name="BtnReload" Content="Reload library" Margin="0"/>
                    </StackPanel>
                    <ListBox x:Name="LstCategories">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Script list -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="TxtListHeader" DockPanel.Dock="Top" Text="ALL SCRIPTS" Style="{StaticResource SectionLabel}" Margin="16,14,0,6"/>
                    <ListBox x:Name="LstScripts">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Star}" Foreground="{DynamicResource WarningBrush}" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Badges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="B" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="5,0,5,1" Margin="0,0,4,0">
                                                    <TextBlock x:Name="T" Text="{Binding}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="ADMIN">
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="CHANGES">
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="M365">
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="REMOTE">
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="ERROR">
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Details + output -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="320" MinHeight="120"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,16,24,16">
                        <StackPanel x:Name="PnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock Text="Pick a script on the left" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Its description, targets and inputs will show up here." Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="PnlDetails" Visibility="Collapsed">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="BtnFav" Content="&#x2606; Favorite" Style="{StaticResource GhostButton}"/>
                                    <Button x:Name="BtnEdit" Content="&#x270E; Edit" Style="{StaticResource GhostButton}"/>
                                    <Button x:Name="BtnOpenFile" Content="Show file" Style="{StaticResource GhostButton}" Margin="0"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtName" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </DockPanel>
                            <ItemsControl x:Name="IcBadges" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="7,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtDesc" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextBrush}" LineHeight="19"/>
                            <TextBlock x:Name="TxtMeta" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock x:Name="TxtWarn" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed"/>

                            <StackPanel x:Name="PnlTarget">
                                <TextBlock Text="TARGET COMPUTERS" Style="{StaticResource SectionLabel}"/>
                                <TextBox x:Name="TxtTargets" Height="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="TxtTargetHint" Text="Leave empty to run on this PC. Enter names separated by commas or new lines to run over PowerShell Remoting (WinRM)."
                                           FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <WrapPanel>
                                    <Button x:Name="BtnLoadList" Content="Load list from file..." Margin="0,0,6,6"/>
                                    <Button x:Name="BtnFromAD" Content="Find in Active Directory..." Margin="0,0,6,6"/>
                                    <Button x:Name="BtnRunAs" Content="Run as: current user" Margin="0,0,6,6"
                                            ToolTip="Use a different account for remote computers (for example a domain admin). Kept in memory only."/>
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock x:Name="TxtParamsHeader" Text="INPUTS" Style="{StaticResource SectionLabel}"/>
                            <StackPanel x:Name="PnlParams"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="BtnRun" Content="&#x25B6;  Run" Style="{StaticResource AccentButton}" Padding="22,7" FontSize="13.5"/>
                                <Button x:Name="BtnWhatIf" Content="What-If (dry run)" Padding="14,7"
                                        ToolTip="Show what the script would change without changing anything"/>
                                <Button x:Name="BtnStop" Content="&#x25A0;  Stop" Padding="14,7" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"/>

                <Border Grid.Row="2" Background="{DynamicResource OutBgBrush}">
                    <TabControl x:Name="TabOutput">
                        <TabItem x:Name="TabItemOutput" Header="Output">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                    <DockPanel>
                                        <CheckBox x:Name="ChkWrap" DockPanel.Dock="Right" Content="Wrap" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnExportCsv" Content="Export CSV" Style="{StaticResource GhostButton}"/>
                                            <Button x:Name="BtnExportHtml" Content="Export HTML report" Style="{StaticResource GhostButton}"/>
                                            <Button x:Name="BtnOpenReports" Content="Open Reports" Style="{StaticResource GhostButton}"/>
                                            <Button x:Name="BtnCopy" Content="Copy" Style="{StaticResource GhostButton}"/>
                                            <Button x:Name="BtnSaveText" Content="Save text" Style="{StaticResource GhostButton}"/>
                                            <Button x:Name="BtnClear" Content="Clear" Style="{StaticResource GhostButton}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                                <RichTextBox x:Name="RtbOutput" IsReadOnly="True" BorderThickness="0" Padding="10,6"
                                             Background="{DynamicResource OutBgBrush}" Foreground="{DynamicResource OutputBrush}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsDocumentEnabled="True"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="TabItemTerminal" Header="Terminal">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="8,0"
                                                   Text="Shares the Tech Kit session (M365 connections, variables). Up/Down = history, Tab = complete, Esc = clear line"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnTermClear" Content="Clear" Style="{StaticResource GhostButton}"/>
                                            <Button x:Name="BtnTermCopy" Content="Copy" Style="{StaticResource GhostButton}"/>
                                            <Button x:Name="BtnTermPopOut" Content="Pop out console" Style="{StaticResource GhostButton}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                                    <DockPanel>
                                        <TextBlock x:Name="TxtPrompt" DockPanel.Dock="Left" Text="PS&gt;" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CommandBrush}" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtTermInput" BorderThickness="0" Background="Transparent" Padding="0,4"/>
                                    </DockPanel>
                                </Border>
                                <RichTextBox x:Name="RtbTerminal" IsReadOnly="True" BorderThickness="0" Padding="10,6"
                                             Background="{DynamicResource OutBgBrush}" Foreground="{DynamicResource OutputBrush}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProgress" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PrgStatus" Width="160" Height="6" Visibility="Collapsed" Minimum="0" Maximum="100"
                                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
